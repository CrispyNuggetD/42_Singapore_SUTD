dli() {
  _dailylogin_dependencies || return $?
  if [[ "${ZSHRC_SETUP_DONE:-0}" == 1 && "${_DAILYLOGIN_REFRESHED:-0}" != 1 ]] && _dailylogin_enabled "$autoupdatezshrc"; then
    _dailylogin_handoff dli "$@"
    return $?
  fi
  _privatebackup_check
  # Personal commands still run if a daily task fails; retain failure status.
  # Arguments are passed only to your personal Bash script.
  local daily_result=0 items_result=0
  local -x DAILY_TMUX_DEFER_SHOW=1 DAILY_TMUX_BATCH=1
  dailylogin || daily_result=$?
  if _dailylogin_enabled "$loginitems"; then
