      _daily_terminal open --cwd "$PWD" "${LOGIN_ITEMS_TMUX_ROLE:-login-items}" -- bash "$LOGIN_ITEMS_SCRIPT" "$@" || items_result=$?
    else
      items_result=$?
    fi
  fi
  _daily_terminal show-all || return 1
  (( daily_result == 0 )) || return "$daily_result"
  return "$items_result"
}

# A dynamically scoped guard permits one update and one latest-entry dispatch.
# Do not recurse through pull: the new workflow inherits the guard and runs once.
_dailylogin_handoff() {
  local entry="$1"
  shift
  local _DAILYLOGIN_REFRESHED=1
  local -i dailylogin_done=0 dailylogin_skipped=0 dailylogin_failed=0
  local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/42-shell"
  (umask 077; command mkdir -p -- "$log_dir"; command touch -- "$log_dir/dailylogin.log") || return 1
  {
    print -r -- "=== dailylogin workflow update $(date) ==="
    if ! _dailylogin_run 'Pull shared repository' - pullzshrc ||
       ! _dailylogin_run 'Update shared .zshrc block' - synczshrc ||
       ! _dailylogin_run 'Load latest workflow' - _dailylogin_source; then
      _dailylogin_log STOP 'Update failed; no login tasks were started.'
      return 1
    fi
  } > >(command tee -a -- "$log_dir/dailylogin.log") 2>&1
  "$entry" "$@"
}

