# Clear stale Chrome profile locks after closing Chrome on all computers.
# Optional argument: a custom Chrome user-data directory.
unblockchrome() {
  local profile_dir="${1:-${CHROME_USER_DATA_DIR:-${CHROME_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/google-chrome}}"
  local process_status

  if (( $# > 1 )); then
    print -u2 -- 'Usage: unblockchrome [user-data-directory]'
    return 1
  fi
  command pgrep -u "$EUID" -x 'chrome|google-chrome' >/dev/null 2>&1
  process_status=$?
  if (( process_status == 0 )); then
    print -u2 -- 'Close Chrome before running unblockchrome.'
    return 1
  elif (( process_status != 1 )); then
    print -u2 -- 'Could not check whether Chrome is running; locks left unchanged.'
    return 1
  fi
  if [[ ! -d "$profile_dir" ]]; then
    print -u2 -- "Chrome profile directory not found: $profile_dir"
    return 1
  fi
  command rm -f -- "$profile_dir/SingletonLock" "$profile_dir/SingletonSocket" "$profile_dir/SingletonCookie" || return 1
  print -r -- "Chrome locks cleared: $profile_dir"
}

