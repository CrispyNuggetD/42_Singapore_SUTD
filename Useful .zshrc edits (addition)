    '  Main Git sync retains its existing commit/push prompts.' \
    '  Edit local controls outside the shared markers; TRUE/1 = ON, FALSE/0 = OFF.' ''
}

# "-" means always run. Command output remains visible at every verbosity level.
_dailylogin_run() {
  local label="$1" control="$2" result
  shift 2
  if [[ "$control" != - ]] && ! _dailylogin_enabled "${(P)control}"; then
    _dailylogin_log SKIP "$label ($control=${(P)control})"
    (( dailylogin_skipped += 1 ))
    return 0
  fi
  _dailylogin_log RUN "$label"
  "$@"
  result=$?
  if (( result == 0 )); then
    (( dailylogin_done += 1 ))
    _dailylogin_log DONE "$label"
  else
    (( dailylogin_failed += 1 ))
    _dailylogin_log FAILED "$label (exit $result)"
  fi
  return "$result"
}

_dailylogin_summary() {
  _dailylogin_log SUMMARY "$dailylogin_done completed; $dailylogin_skipped skipped; $dailylogin_failed failed."
}

_dailylogin_chrome() {
  command -v google-chrome >/dev/null 2>&1 || {
    print -u2 -- 'google-chrome is not installed.'
    return 1
  }
  # Match this user's Chrome processes; do not create another tab/window.
  if command pgrep -u "$EUID" -x 'chrome|google-chrome' >/dev/null 2>&1; then
    print -- 'Chrome is already running; keeping its existing windows.'
    return 0
  fi
  (command google-chrome >/dev/null 2>&1 &!)
}

# Pull only: preserve local changes and stop on conflicts/divergence.
pullzshrc() {
  local repo_root="${ZSHRC_SHARED_ROOT:-${MAIN_REPO_ROOT:-$HOME/Documents/42_Singapore_SUTD}}"
  print -r -- "Pulling shared shell helpers from $repo_root"
  command git -C "$repo_root" -c merge.autostash=false -c rebase.autostash=false \
    pull --ff-only || {
      print -u2 -- "Repository pull failed; dailylogin stopped before updating .zshrc."
      return 1
    }
}

dailylogin() {
  local -i dailylogin_done=0 dailylogin_skipped=0 dailylogin_failed=0
  if _dailylogin_enabled "$autoupdatezshrc"; then
    if ! _dailylogin_run 'Pull shared repository' - pullzshrc ||
       ! _dailylogin_run 'Update shared .zshrc block' - synczshrc ||
       ! _dailylogin_run 'Reload .zshrc' - source "${ZDOTDIR:-$HOME}/.zshrc"; then
      _dailylogin_log STOP 'Remaining dailylogin tasks were not run because startup failed.'
      _dailylogin_summary
      return 1
    fi
  else
    _dailylogin_log SKIP "Pull/update/reload .zshrc (autoupdatezshrc=$autoupdatezshrc)"
    (( dailylogin_skipped += 3 ))
  fi
  # Report the effective settings and dispatch the functions loaded by source.
  _dailylogin_settings
  local -x DAILY_TMUX_BATCH=1
  _dailylogin_tasks "$@"
  if ! _daily_terminal show; then
    (( dailylogin_failed += 1 ))
    _dailylogin_log FAILED 'Show tmux workspace (use dailyterm to reconnect)'
  fi
  _dailylogin_summary
  (( dailylogin_failed == 0 ))
}

_dailylogin_tasks() {
  _dailylogin_run 'Codex installation/full access/window request' startcodex start_codex || true
  _dailylogin_run "Pull other repositories under $DOCUMENTS_REPOS_ROOT" pullotherrepos syncdocs || true
  _dailylogin_run 'LAN42 lobby window request' startlan42 start_lan42 || true
