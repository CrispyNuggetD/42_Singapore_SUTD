# Pull other working repositories below Documents, including nested clones and
# worktrees/submodules (.git files). Never stage, commit or push these repos.
# Pull the collaborative mailbox itself, but never scan its contents for repos.
# Symlinked subdirectories are not followed; a symlinked root is supported.
syncdocs() (
  if ! _dailylogin_enabled "$pullotherrepos"; then
    echo "Other repository pulls disabled (pullotherrepos=$pullotherrepos)"
    return 0
  fi
  local root="${DOCUMENTS_REPOS_ROOT:-$HOME/Documents}"
  local mailbox="${MAC_REMOTE_ROOT:-$HOME/mac-remote}"
  local listing marker repo upstream
  local total=0 updated=0 failed=0 scan_failed=0
  [[ -d "$root" ]] || { print -u2 -- "Missing repository search folder: $root"; return 1; }
  listing=$(mktemp "${TMPDIR:-/tmp}/syncdocs.XXXXXXXX") || return 1
  trap 'rm -f -- "$listing"' EXIT
  # Canonical paths also cover a symlinked search root or mailbox setting.
  root="${root:A}"
  mailbox="${mailbox:A}"
  # Emit the mailbox root once and prune it; other nested clones remain included.
  find -H "$root" \( -type d -path "${(b)mailbox}" -prune -print0 \) -o \
    \( -name .git \( -type d -o -type f \) -prune -print0 \) > "$listing" || scan_failed=1
  while IFS= read -r -d '' marker; do
    if [[ "$marker" == "$mailbox" ]]; then
      [[ -d "$marker/.git" || -f "$marker/.git" ]] || continue
      repo="$marker"
    else
      repo="${marker%/.git}"
    fi
    # Compare canonical paths, including when the main repo path uses symlinks.
    [[ -n "$MAIN_REPO_ROOT" && "${repo:A}" == "${MAIN_REPO_ROOT:A}" ]] && continue
    (( total += 1 ))
    print -r -- "" "Pulling: $repo"
    if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      print -u2 -- 'Invalid/unavailable working repository; continuing.'
      (( failed += 1 ))
      continue
    fi
    if ! upstream=$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
      print -u2 -- 'No upstream (or detached HEAD); configure a tracking branch and retry.'
      (( failed += 1 ))
      continue
    fi
    # No password prompts: inaccessible remotes must not block the whole batch.
    # Refuse merges/rebases/autostash; preserve local work if a pull cannot apply.
    if GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=10" \
      git -C "$repo" -c merge.autostash=false -c rebase.autostash=false pull --no-rebase --ff-only; then
      (( updated += 1 ))
    else
      print -u2 -- "Pull failed for $repo; local work preserved. Continuing."
      (( failed += 1 ))
    fi
  done < "$listing"
  print -r -- "" "Documents sync: $updated/$total pulls succeeded; $failed need attention."
  if (( scan_failed )); then
    print -u2 -- 'Some folders could not be scanned; see find errors above.'
  fi
  (( failed == 0 && scan_failed == 0 ))
)

# sync current main GitHub repo: pull, then commit & push local changes
syncproj() {
  if [ -z "$MAIN_REPO_ROOT" ]; then
    echo "MAIN_REPO_ROOT is not set. Please set it in your .zshrc."
    return 1
  fi

  if [ ! -d "$MAIN_REPO_ROOT/.git" ]; then
    echo "No git repo found at: $MAIN_REPO_ROOT"
    return 1
  fi

  # jump into main repo
  cd "$MAIN_REPO_ROOT" || {
    echo "Failed to cd into $MAIN_REPO_ROOT"
    return 1
  }

  echo "Syncing main GitHub repo at:"
  echo "  $MAIN_REPO_ROOT"
  echo

  # 1) Always pull latest from GitHub first
  echo "Pulling from remote..."
  git pull
  echo

  # 2) Show current status
  echo "Current status:"
  git status
  echo

  # 3) If no changes, we're done
  if [[ -z "$(git status --porcelain)" ]]; then
    echo "No local changes to commit. Repo is up to date."
    return 0
  fi

  # 4) Stage everything (tracked + untracked + deletions)
  git add -A

  # show status so you see what will be committed
  echo
  echo "Changes staged for commit:"
  git status
  echo

  # 5) Ask for commit title/body (zsh style)
  read "title?Commit title (main repo): "
  read "body?Commit details (optional, leave blank if none): "

  if [[ -n "$body" ]]; then
    git commit -m "$title" -m "$body"
  else
    git commit -m "$title"
  fi

  # 6) Push to GitHub
  git push

  echo
  echo "Committed & pushed with message:"
  echo "--------------------------------"
  echo "$title"
  if [[ -n "$body" ]]; then
    echo
    echo "$body"
  fi
  echo "--------------------------------"
}   

loginbefore12() {
  last "$USER" | awk '
  # Only process normal login lines where $7 is a time like H:MM or HH:MM
  $7 ~ /^[0-9]?[0-9]:[0-9][0-9]$/ {
    day = $4 " " $5 " " $6

    # If we moved to a new day, reset state + buffer
    if (day != cur_day) {
      cur_day = day
      ok = 0
      printed = 0
      nbuf = 0
    }

    # Build exactly the output you wanted (same fields as your print)
    line = $1 " " $4 " " $5 " " $6 " " $7
    for (i=8; i<=13; i++) line = line " " $i

    # Buffer lines until we know the day qualifies
    if (!printed) {
      buf[++nbuf] = line
    }

    # Check if this login was before 12:00
    split($7, t, ":")
    if ((t[1] + 0) < 12) ok = 1

    # If the day qualifies and we haven’t printed it yet, dump the buffer
    if (ok && !printed) {
      for (j=1; j<=nbuf; j++) print buf[j]
      printed = 1
    } else if (printed) {
      # Once we’re printing this day, print subsequent lines immediately
      print line
    }
  }'
}

hourslogged() {
  # Estimate login totals from local records over the last seven calendar dates.

  set -u

  TARGET_HOURS=50
  TARGET_MIN=$((TARGET_HOURS * 60))

  YEAR="$(date +%Y)"

  # Build last 7 ISO dates (oldest -> newest) with NO trailing blank line.
  LAST7_DATES="$(i=6; while [ "$i" -ge 0 ]; do
    date -d "$i days ago" +%F
    i=$((i - 1))
  done)"

  out="$(
    last "$USER" 2>/dev/null | gawk -v TARGET_MIN="$TARGET_MIN" -v YEAR="$YEAR" -v LAST7_DATES="$LAST7_DATES" '
    BEGIN {
      now = systime()

      n = split(LAST7_DATES, D, "\n")
      for (i = 1; i <= n; i++) {
        gsub(/^[ \t\r]+|[ \t\r]+$/, "", D[i])
        if (D[i] != "")
          daymin[D[i]] = 0
      }

      monnum["Jan"]=1; monnum["Feb"]=2; monnum["Mar"]=3; monnum["Apr"]=4
      monnum["May"]=5; monnum["Jun"]=6; monnum["Jul"]=7; monnum["Aug"]=8
      monnum["Sep"]=9; monnum["Oct"]=10; monnum["Nov"]=11; monnum["Dec"]=12
    }

    function epoch_from_parts(mon, dd, hhmm,    y, mm, s, cmd, e) {
      mm = monnum[mon]
      if (mm == 0)
        return 0

      y = YEAR + 0
      s = sprintf("%04d-%02d-%02d %s", y, mm, dd + 0, hhmm)
      cmd = "date -d \"" s "\" +%s"
      cmd | getline e
      close(cmd)
      e += 0

      if (e > now) {
        y = y - 1
        s = sprintf("%04d-%02d-%02d %s", y, mm, dd + 0, hhmm)
        cmd = "date -d \"" s "\" +%s"
        cmd | getline e
        close(cmd)
        e += 0
      }
      return e
    }

    function key_from_epoch(e,    cmd, k) {
      cmd = "date -d @" e " +%F"
      cmd | getline k
      close(cmd)
      return k
    }

    # We only trust lines where $7 is a login time like H:MM or HH:MM
    $7 ~ /^[0-9]?[0-9]:[0-9][0-9]$/ {
      # last fields (from your sample):
      # $4=DOW, $5=Mon, $6=DD, $7=HH:MM
      start = epoch_from_parts($5, $6, $7)
      if (start <= 0)
        next

      key = key_from_epoch(start)
      if (!(key in daymin))
        next

      # explicit duration: (HH:MM)
      if (match($0, /\(([0-9]+):([0-9][0-9])\)$/, t)) {
        mins = (t[1] + 0) * 60 + (t[2] + 0)
        daymin[key] += mins
        next
      }

      # open-ended session
      mins = int((now - start) / 60)
      if (mins < 0)
        mins = 0
      daymin[key] += mins
    }

    END {
      n = split(LAST7_DATES, D, "\n")

      print "Per-day login totals (last 7 days):"
      for (i = 1; i <= n; i++) {
        gsub(/^[ \t\r]+|[ \t\r]+$/, "", D[i])
        if (D[i] == "")
          continue

        cmd = "date -d \"" D[i] "\" +%a"
        cmd | getline wd
        close(cmd)

        h = int(daymin[D[i]] / 60)
        m = daymin[D[i]] % 60
        printf "%s (%s): %dh %02dm\n", D[i], wd, h, m
      }

      roll = 0
      for (i = 1; i <= n; i++) {
        gsub(/^[ \t\r]+|[ \t\r]+$/, "", D[i])
        if (D[i] != "")
          roll += daymin[D[i]]
      }

      roll_h = int(roll / 60)
      roll_m = roll % 60

      avg = int(roll / 7)
      avg_h = int(avg / 60)
      avg_m = avg % 60

      print ""
      printf "Rolling 7-day total: %dh %02dm\n", roll_h, roll_m
      printf "Rolling 7-day average per day: %dh %02dm\n", avg_h, avg_m

      remaining = TARGET_MIN - roll
      if (remaining < 0)
        remaining = 0

      rh = int(remaining / 60)
      rm = remaining % 60

      print ""
      printf "Target (rolling 7 days): %dh 00m\n", int(TARGET_MIN / 60)
      printf "Remaining to reach target: %dh %02dm\n", rh, rm

      if (remaining == 0)
        print "You already hit the 50h rolling-7-days award ✅"
      else
        printf "If you stay logged in from now, you need ~%dh %02dm more.\n", rh, rm

      printf "REM_MIN=%d\n", remaining
    }'
  )"

  # If awk/date blew up, out might be empty. Fail loudly.
  if [ -z "$out" ]; then
    echo "Error: produced no output. Check: gawk installed? GNU date? last output?" >&2
    exit 1
  fi

  # Print human output (everything except REM_MIN line)
  printf "%s\n" "$out" | awk '!/^REM_MIN=/'

  # Extract remaining minutes
  rem_min="$(printf "%s\n" "$out" | awk -F= '/^REM_MIN=/{print $2; exit}')"
  [ -z "$rem_min" ] && rem_min=0

  echo ""
  if [ "$rem_min" -eq 0 ]; then
    echo "Stay logged in until: now (already achieved)"
  else
    finish_time="$(date -d "now + $rem_min minutes" +"%I:%M%p")"
    finish_day="$(date -d "now + $rem_min minutes" +"%F")"
    today="$(date +%F)"

    finish_time="$(printf "%s" "$finish_time" | tr 'APM' 'apm' | sed 's/^0//')"

    if [ "$finish_day" = "$today" ]; then
      echo "Stay logged in until: $finish_time"
    else
      finish_label="$(date -d "now + $rem_min minutes" +"%a %Y-%m-%d")"
      echo "Stay logged in until: $finish_time ($finish_label)"
    fi
  fi
}

adjust_brightness() {
  if ! _dailylogin_enabled "$adjustbrightness"; then
    echo "Brightness adjustment disabled (adjustbrightness=$adjustbrightness)"
    return 0
  fi

  if ! [[ "$setbrightness" =~ '^[0-9]+$' ]] ||
     [ "$setbrightness" -lt 0 ] || [ "$setbrightness" -gt 100 ]; then
    echo "Invalid brightness: $setbrightness (expected 0-100)"
    return 1
  fi

  if command -v gdbus >/dev/null 2>&1 &&
     gdbus call --session \
       --dest org.gnome.SettingsDaemon.Power \
       --object-path /org/gnome/SettingsDaemon/Power \
       --method org.freedesktop.DBus.Properties.Set \
       org.gnome.SettingsDaemon.Power.Screen Brightness \
       "<int32 $setbrightness>" >/dev/null 2>&1; then
    echo "Brightness set to $setbrightness%"
    return 0
  fi

  if command -v xbacklight >/dev/null 2>&1 &&
     xbacklight -set "$setbrightness" >/dev/null 2>&1; then
    echo "Brightness set to $setbrightness%"
    return 0
  fi

  echo "Failed to set brightness to $setbrightness%"
  return 1
}

# Start the enrolled 42 worker in its named tmux window.
start_mailbox() {
  if ! _dailylogin_enabled "${startmailbox:-0}"; then
    echo "Mac remote mailbox disabled (startmailbox=${startmailbox:-0})"
    return 0
  fi

  if [ "$(uname -s)" != "Linux" ]; then
    echo "Mac remote client startup is for the Linux campus computer."
    return 0
  fi

  local mailbox_root="${MAC_REMOTE_ROOT:-$HOME/mac-remote}"
  if [ ! -f "$mailbox_root/device.sh" ]; then
    echo "Mailbox clone not found: $mailbox_root"
    echo "Set MAC_REMOTE_ROOT to your mac-remote clone in ~/.zshrc."
    return 1
  fi
  if [ ! -f "$mailbox_root/.mailbox/identity/device.json" ]; then
    echo "Enroll this computer first: run bash setup.sh from $mailbox_root"
    echo "Then have the Mac approve its device fingerprint and sign in to Codex in VS Code."
    return 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required by the mailbox worker."
    return 1
  fi

  # Probe the worker's actual lock; a leftover lock file alone is harmless.
  # The worker itself also locks before execution, preventing duplicate workers.
  if python3 - "$mailbox_root/.mailbox/42/worker.lock" <<'PYLOCK'
import fcntl
from pathlib import Path
import sys
path = Path(sys.argv[1])
if path.exists():
    with path.open('r') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit(2)
PYLOCK
  then
    :
  else
    local lock_result=$?
    if [ "$lock_result" -eq 2 ]; then
      echo "Mac remote mailbox is already running."
      [[ "$DAILY_TMUX_BATCH" == 1 ]] || _daily_terminal show
      return 0
    fi
    echo "Could not check the mailbox worker lock; leaving it alone."
    return 1
  fi

  # Update before starting a new worker. Preserve local changes and never merge.
  echo "Updating Mac remote mailbox"
  if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=10" \
    command git -C "$mailbox_root" -c merge.autostash=false -c rebase.autostash=false \
      pull --no-rebase --ff-only; then
    echo "Mailbox update failed; no new worker window opened. Resolve the Git error and run start_mailbox again." >&2
    return 1
  fi

  local worker_command='cd -- "$1" || exit 1
printf "42 mailbox: detaching keeps the worker running. Ctrl-C stops it.\n"
bash device.sh start
worker_result=$?
printf "\nMailbox stopped (exit %s). Check messages above; press Enter to close.\n" "$worker_result"
read -r _'
  _daily_terminal open --cwd "$mailbox_root" mailbox -- bash -c "$worker_command" mailbox "$mailbox_root"
}

