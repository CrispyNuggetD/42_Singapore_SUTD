# Shared boolean handling: controls accept TRUE/FALSE or 1/0.
_dailylogin_enabled() {
  [[ "$1" == 1 || "${(U)1}" == TRUE ]]
}

_dailylogin_log() {
  _dailylogin_enabled "${verbosity:-TRUE}" || return 0
  printf '[%-7s] %s\n' "$1" "$2"
}

_dailylogin_control_row() {
  local key="$1" meaning="$2" value="${(P)1}" state=OFF
  _dailylogin_enabled "$value" && state=ON
  printf '  %-20s %-5s %-7s %s\n' "$key" "$state" "$value" "$meaning"
}

_dailylogin_settings() {
