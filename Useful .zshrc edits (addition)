  _dailylogin_control_row autoupdatezshrc 'Pull shared repo, update .zshrc, then reload'
  _dailylogin_control_row startcodex 'Ensure installation/full access; request Codex window'
  _dailylogin_control_row pullotherrepos 'Pull other repos; main repo excluded'
  _dailylogin_control_row startlan42 'Request LAN42 lobby window'
  _dailylogin_control_row startmailbox 'Start mailbox unless its worker is already running'
  _dailylogin_control_row startstayon 'Start stayon in automatic mode'
  _dailylogin_control_row adjustbrightness 'Set brightness to setbrightness'
