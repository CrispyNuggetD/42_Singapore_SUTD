dailylogin() {
  if [[ "${ZSHRC_SETUP_DONE:-0}" != 1 ]]; then
    if [[ -o interactive && -t 0 ]]; then
      setupzshrc || return $?
      print -- 'Setup complete. Run dailylogin again to start your selected tasks.'
      return 0
    fi
    print -u2 -- 'Shell setup required: run setupzshrc in an interactive terminal first.'
    return 1
  fi
  local -i dailylogin_done=0 dailylogin_skipped=0 dailylogin_failed=0
  if _dailylogin_enabled "$autoupdatezshrc"; then
    if ! _dailylogin_run 'Pull shared repository' - pullzshrc ||
       ! _dailylogin_run 'Update shared .zshrc block' - synczshrc ||
       ! _dailylogin_run 'Reload .zshrc' - source "${ZDOTDIR:-$HOME}/.zshrc"; then
      _dailylogin_log STOP 'Remaining dailylogin tasks were not run because startup failed.'
      _dailylogin_summary
      return 1
    fi
  else
    _dailylogin_log SKIP "Pull/update/reload .zshrc (autoupdatezshrc=$autoupdatezshrc)"
    (( dailylogin_skipped += 3 ))
  fi
  # Report the effective settings and dispatch the functions loaded by source.
  _dailylogin_settings
  local -x DAILY_TMUX_BATCH=1
  _dailylogin_tasks "$@"
  _dailylogin_run 'Empty shell window' - _daily_terminal open --cwd "$PWD" zsh -- zsh -i || true
  if ! _daily_terminal show; then
    (( dailylogin_failed += 1 ))
    _dailylogin_log FAILED 'Show tmux workspace (use workterm to reconnect)'
  fi
  _dailylogin_summary
  (( dailylogin_failed == 0 ))
}

