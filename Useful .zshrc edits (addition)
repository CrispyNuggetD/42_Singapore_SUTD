# Other interactive shells reload at their next prompt after resetdailylogin.
_42_shell_reload() {
  local marker="$HOME/.cache/42-shell/reload-request" token=''
  [[ ! -f "$marker" ]] || token="$(< "$marker")"
  if [[ "$token" != "${_42_shell_reload_seen:-}" ]]; then
    _42_shell_reload_seen="$token"
    LOGIN_STARTUP_SKIP=1 source "${ZDOTDIR:-$HOME}/.zshrc"
  fi
}
_42_shell_reload_seen=''
