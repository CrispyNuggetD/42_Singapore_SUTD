# Close detached tmux sessions and their terminal jobs; keep attached sessions.
quithidden() {
  command -v tmux >/dev/null 2>&1 || { print -- 'tmux is not installed.'; return 0; }
  local -a tmux_args
  tmux_args=()
  [[ -n "${DAILY_TMUX_SOCKET:-}" ]] && tmux_args=(-S "$DAILY_TMUX_SOCKET")
  local sessions session_id
  sessions=$(command tmux "${tmux_args[@]}" list-sessions -F '#{session_id}' 2>/dev/null) || {
    print -- 'No tmux sessions running.'
    return 0
  }
  for session_id in ${(f)sessions}; do
    # Check attachment inside the server immediately before closing the session.
    command tmux "${tmux_args[@]}" if-shell -F -t "$session_id" '#{==:#{session_attached},0}' \
      "kill-session -t $session_id" || return 1
  done
  print -- 'Detached tmux sessions closed. Attached sessions kept.'
}

# Save work and private chats before closing ALL tmux sessions (attached too).
# Failures keep terminals open; the platform screen lock is attempted last, even on failure.
# Remove the previous name when reloading this configuration in an existing shell.
unfunction leaveschool 2>/dev/null || true
_42_lock_screen() {
  if [[ "$OSTYPE" == darwin* ]]; then
    local locker='/System/Library/CoreServices/Menu Extras/User.menu/Contents/Resources/CGSession'
    if [[ -x "$locker" ]]; then
      command "$locker" -suspend
    else
      command osascript -e 'tell application "System Events" to keystroke "q" using {control down, command down}'
    fi
  else
    ft_lock
  fi
}

_leavesch_backup() {
  if [[ "$OSTYPE" == darwin* ]]; then
    # Publish resumable school continuations as well as the private JSONL backup.
    command python3 "$ZSHRC_RUNTIME_ROOT/codex_return.py" export \
      --private "${CODEX_PRIVATE_REPO_ROOT:-$HOME/Documents/42_Singapore_SUTD_hnah_private}" || return $?
  fi
  DOCUMENTS_REPOS_ROOT="${DOCUMENTS_REPOS_ROOT:-$HOME/Documents}" \
    command python3 "$ZSHRC_RUNTIME_ROOT/leaveschool.py" backup
}
_leavesch_quit_apps() {
  LEAVESCH_KEEP_APPS="${LEAVESCH_KEEP_APPS:-}" \
    closechromeonleave="${closechromeonleave:-TRUE}" \
    command python3 "$ZSHRC_RUNTIME_ROOT/soft_quit_apps.py" "$@"
}
leavesch() {
  setopt localoptions localtraps
  trap 'return 130' INT
  trap 'return 143' TERM
  trap 'return 129' HUP
  {
    local helper="$ZSHRC_RUNTIME_ROOT/leaveschool.py"
    local failed=0
    _leavesch_backup || return 1
    DOCUMENTS_REPOS_ROOT="${DOCUMENTS_REPOS_ROOT:-$HOME/Documents}" \
      command python3 "$helper" push-all || failed=1
    # Cover a private clone configured outside the Documents scan as well.
    local private="${CODEX_PRIVATE_REPO_ROOT:-$HOME/Documents/42_Singapore_SUTD_hnah_private}"
    local docs="${DOCUMENTS_REPOS_ROOT:-$HOME/Documents}"
    if [[ "${private:A}" != "${docs:A}" && "${private:A}" != "${docs:A}/"* ]]; then
      command python3 "$helper" push-private || failed=1
    fi
    if (( failed )); then
      print -u2 -- 'leavesch: some pushes failed; tmux kept open. Fix the errors and retry.'
      return 1
    fi
    if _dailylogin_enabled "${closeappsonleave:-TRUE}"; then
      _leavesch_quit_apps || {
        print -u2 -- 'leavesch: an app needs attention; tmux kept open. Finish its prompts and retry.'
        return 1
      }
    elif _dailylogin_enabled "${closechromeonleave:-TRUE}"; then
      command python3 "$ZSHRC_RUNTIME_ROOT/close_chrome.py" || {
        print -u2 -- 'leavesch: Chrome has not finished closing; tmux kept open.'
        return 1
      }
    fi
    if _dailylogin_enabled "${closeappsonleave:-TRUE}"; then
      # Editors may flush newly saved files while handling their normal Quit.
      print -- 'Saving final app changes before closing terminals.'
      _leavesch_backup || return 1
      DOCUMENTS_REPOS_ROOT="${DOCUMENTS_REPOS_ROOT:-$HOME/Documents}" \
        command python3 "$helper" push-all || return 1
      if [[ "${private:A}" != "${docs:A}" && "${private:A}" != "${docs:A}/"* ]]; then
        command python3 "$helper" push-private || return 1
      fi
    fi
    print -- 'Work and chat backup saved. Closing all tmux sessions, including attached sessions.'
    local -a tmux_args
    tmux_args=()
    [[ -n "${DAILY_TMUX_SOCKET:-}" ]] && tmux_args=(-S "$DAILY_TMUX_SOCKET")
    # Keep this shell alive after its tmux terminal closes so the lock runs.
    trap '' HUP
    if command -v tmux >/dev/null 2>&1 && command tmux "${tmux_args[@]}" list-sessions >/dev/null 2>&1; then
      command tmux "${tmux_args[@]}" kill-server || return 1
    fi
    if _dailylogin_enabled "${closeappsonleave:-TRUE}"; then
      _leavesch_quit_apps --schedule-terminals || return 1
    fi
  } always {
    _42_lock_screen
  }
}

# Midday checkpoint: side-push first, then WIP commits; keep tmux jobs running.
# Record each break start in ${XDG_STATE_HOME:-~/.local/state}/42-shell/breaks.jsonl.
# Codex context is optional (GOBREAK_CODEX_CONTEXT=FALSE disables it), main repo only.
# The automatic screen-lock/idle private backup remains independent.
# Folder scan plus colon-separated additional/excluded repository paths.
# DOCUMENTS_PUSH_EXCLUDE is also respected; Go Break has no built-in exclusions.
GOBREAK_REPOS_ROOT="${GOBREAK_REPOS_ROOT-${DOCUMENTS_REPOS_ROOT:-$HOME/Documents}}"
GOBREAK_INCLUDE_REPOS="${GOBREAK_INCLUDE_REPOS:-}"
GOBREAK_EXCLUDE_REPOS="${GOBREAK_EXCLUDE_REPOS:-}"
gobreak() {
  setopt localoptions localtraps
  trap 'return 130' INT
  trap 'return 143' TERM
  trap 'return 129' HUP
  {
    GOBREAK_REPOS_ROOT="$GOBREAK_REPOS_ROOT" \
      GOBREAK_INCLUDE_REPOS="$GOBREAK_INCLUDE_REPOS" \
      GOBREAK_EXCLUDE_REPOS="$GOBREAK_EXCLUDE_REPOS" \
      DOCUMENTS_REPOS_ROOT="${DOCUMENTS_REPOS_ROOT:-$HOME/Documents}" \
      _GOBREAK_LOCK_IN_SHELL=1 \
      command python3 "$ZSHRC_RUNTIME_ROOT/gobreak.py" --all-repos
  } always {
    _42_lock_screen
  }
}

# Pull private Mac returns, then register separate resumable Ubuntu chat copies.
# Uses the same CODEX_HOME as the extension; no credentials/config are copied.
importhome() {
  local private="${CODEX_PRIVATE_REPO_ROOT:-$HOME/Documents/42_Singapore_SUTD_hnah_private}"
  if [[ ! -d "$private/.git" && ! -f "$private/.git" ]]; then
    print -- 'Private repository unavailable; skipping home-chat import.'
    return 0
  fi
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=15" \
    command git -C "$private" -c merge.autostash=false -c rebase.autostash=false \
    pull --no-rebase --ff-only || return 1
  local helper="$ZSHRC_RUNTIME_ROOT/codex_return.py"
  # First update can still be running the previous installer's helper list.
  [[ -f "$helper" ]] || helper="${ZSHRC_SHARED_ROOT:-$MAIN_REPO_ROOT}/tools/codex_return.py"
  command python3 "$helper" import \
    --private "$private" --main-repo "$MAIN_REPO_ROOT" "$@"
}

