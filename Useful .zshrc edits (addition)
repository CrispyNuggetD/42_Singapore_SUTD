# Ensure global full access; leave an already-correct config untouched.
codex_full_access() {
  python3 - "${CODEX_HOME:-$HOME/.codex}/config.toml" <<'PYCODEX'
from pathlib import Path
from datetime import datetime
import re
import shutil
import sys

config = Path(sys.argv[1]).expanduser().resolve()
config.parent.mkdir(parents=True, exist_ok=True)
original = config.read_text() if config.exists() else ""
# Only replace global keys; preserve project and profile sections.
section = re.search(r"(?m)^\s*\[", original)
boundary = section.start() if section else len(original)
header, sections = original[:boundary], original[boundary:]
# Check both TOML quote styles before deciding whether any edit is necessary.
def has_setting(key, value):
    pattern = r"(?m)^[ \t]*" + key + r"[ \t]*=[ \t]*(['\"])" + re.escape(value) + r"\1[ \t]*(?:#.*)?$"
    return re.search(pattern, header)
if has_setting("approval_policy", "never") and has_setting("sandbox_mode", "danger-full-access"):
    print(f"Codex global full access already enabled in {config}")
    sys.exit(0)
header = re.sub(
    r'(?m)^[ \t]*(?:approval_policy|sandbox_mode)[ \t]*=.*(?:\n|$)',
    "", header,
)
updated = ('approval_policy = "never"\n'
           'sandbox_mode = "danger-full-access"\n' + header + sections)
if updated != original:
    if config.exists():
        backup = config.with_name(config.name + ".bak-" + datetime.now().strftime("%Y%m%d-%H%M%S-%f"))
        shutil.copy2(config, backup)
        print(f"Backup: {backup}")
    config.write_text(updated)
    config.chmod(0o600)
print(f"Codex global full access configured in {config}")
print("Restart Codex and start a new session to load the defaults.")
PYCODEX
}

# Install the official standalone CLI only when missing, then open its tmux window.
# Optional local overrides: CODEX_INSTALL_DIR and CODEX_START_DIR.
# Use the general workspace unless the caller explicitly chooses a directory.
codex() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -C|--cd|-C?*|--cd=*) command codex "$@"; return $? ;;
    esac
  done
  command codex --cd "${CODEX_START_DIR:-$HOME/Documents/42_Singapore_SUTD_hnah_private/42}" "$@"
}

start_codex() {
  _dailylogin_enabled "${startcodex:-0}" || return 0
