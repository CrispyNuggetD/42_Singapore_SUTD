  if command pgrep -u "$EUID" -x 'chrome|google-chrome' >/dev/null 2>&1; then
    print -- 'Chrome is already running; keeping its existing windows.'
    return 0
  fi
  (command google-chrome >/dev/null 2>&1 &!)
}

