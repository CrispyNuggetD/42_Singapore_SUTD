# "-" means always run. Command output remains visible at every verbosity level.
_dailylogin_run() {
  local label="$1" control="$2" result
  shift 2
  if [[ "$control" != - ]] && ! _dailylogin_enabled "${(P)control}"; then
    _dailylogin_log SKIP "$label ($control=${(P)control})"
    (( dailylogin_skipped += 1 ))
    return 0
  fi
  _dailylogin_log RUN "$label"
  "$@"
  result=$?
  if (( result == 0 )); then
    (( dailylogin_done += 1 ))
    _dailylogin_log DONE "$label"
  else
    (( dailylogin_failed += 1 ))
    _dailylogin_log FAILED "$label (exit $result)"
    case "$control" in
      startmailbox) print -u2 -- 'Run setupzshrc to set your own MAC_REMOTE_ROOT; enroll your device locally using that clone’s instructions, then rerun dailylogin.' ;;
      startstayon) print -u2 -- 'Run setupzshrc to set STAYON_ROOT to your installed runner, or disable startstayon if you do not use it.' ;;
      openproject) print -u2 -- 'Run setupzshrc to select your own repository and project. Install VS Code if code is unavailable; make fclean requires a project with that target.' ;;
      *) print -u2 -- "Fix the error shown above, then rerun dailylogin. For personal paths or unwanted optional tasks, run setupzshrc ($control)." ;;
    esac
  fi
  return "$result"
}

