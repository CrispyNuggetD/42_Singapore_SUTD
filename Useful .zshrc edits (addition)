# Ensure global full access; leave an already-correct config untouched.
codex_full_access() {
  python3 - "${CODEX_HOME:-$HOME/.codex}/config.toml" <<'PYCODEX'
from pathlib import Path
from datetime import datetime
import re
import shutil
import sys

config = Path(sys.argv[1]).expanduser().resolve()
config.parent.mkdir(parents=True, exist_ok=True)
original = config.read_text() if config.exists() else ""
# Only replace global keys; preserve project and profile sections.
section = re.search(r"(?m)^\s*\[", original)
boundary = section.start() if section else len(original)
header, sections = original[:boundary], original[boundary:]
# Check both TOML quote styles before deciding whether any edit is necessary.
def has_setting(key, value):
    pattern = r"(?m)^[ \t]*" + key + r"[ \t]*=[ \t]*(['\"])" + re.escape(value) + r"\1[ \t]*(?:#.*)?$"
    return re.search(pattern, header)
if has_setting("approval_policy", "never") and has_setting("sandbox_mode", "danger-full-access"):
    print(f"Codex global full access already enabled in {config}")
    sys.exit(0)
header = re.sub(
    r'(?m)^[ \t]*(?:approval_policy|sandbox_mode)[ \t]*=.*(?:\n|$)',
    "", header,
)
updated = ('approval_policy = "never"\n'
           'sandbox_mode = "danger-full-access"\n' + header + sections)
if updated != original:
    if config.exists():
        backup = config.with_name(config.name + ".bak-" + datetime.now().strftime("%Y%m%d-%H%M%S-%f"))
        shutil.copy2(config, backup)
        print(f"Backup: {backup}")
    config.write_text(updated)
    config.chmod(0o600)
print(f"Codex global full access configured in {config}")
print("Restart Codex and start a new session to load the defaults.")
PYCODEX
}

# Install the official standalone CLI only when missing, then open its tmux window.
# Optional local overrides: CODEX_INSTALL_DIR and CODEX_START_DIR.
start_codex() {
  _dailylogin_enabled "${startcodex:-1}" || return 0
  local install_dir="${CODEX_INSTALL_DIR:-$HOME/.local/bin}"
  local codex_bin installer
  local start_dir="${CODEX_START_DIR:-${MAIN_REPO_ROOT:-$HOME}}"
  [[ -d "$start_dir" ]] || { print -u2 -- "Codex directory missing: $start_dir"; return 1; }
  command -v tmux >/dev/null 2>&1 || { print -u2 -- 'tmux is required for Codex windows.'; return 1; }

  codex_bin=$(whence -p codex)
  if [[ -z "$codex_bin" && -x "$install_dir/codex" ]]; then
    codex_bin="$install_dir/codex"
  fi
  if [[ -z "$codex_bin" ]]; then
    print -- 'Installing Codex with the official standalone installer.'
    installer=$(mktemp "${TMPDIR:-/tmp}/codex-install.XXXXXXXX") || return 1
    if ! command curl -fsSL https://chatgpt.com/codex/install.sh -o "$installer"; then
      command rm -f -- "$installer"
      return 1
    fi
    if ! CODEX_NON_INTERACTIVE=1 CODEX_INSTALL_DIR="$install_dir" command sh "$installer"; then
      command rm -f -- "$installer"
      return 1
    fi
    command rm -f -- "$installer"
    codex_bin="$install_dir/codex"
    [[ -x "$codex_bin" ]] || { print -u2 -- "Installer did not create $codex_bin"; return 1; }
  fi
  codex_full_access || return 1
  # Explicit flags also keep project-level defaults from reducing this launch's access.
  local launch='cd -- "$1" || exit 1
"$2" --ask-for-approval never --sandbox danger-full-access
result=$?
if [ "$result" -ne 0 ]; then
  printf "Codex exited with status %s. Press Enter to close.\n" "$result"
  read -r _
fi'
  _daily_terminal open --cwd "$start_dir" codex -- bash -c "$launch" codex-window "$start_dir" "$codex_bin" || return 1
  print -- 'Codex is in tmux. Use dailyterm to return; sign in there if prompted.'
}

