# Resolve known public prerequisites only when explicitly running the workflow.
# No package installation happens when this file is sourced.
_dailylogin_dependencies() {
  local -a needed packages runner
  local tool package
  needed=(python3 tmux git)
  _dailylogin_enabled "${startcodex:-0}" && needed+=(curl)
  _dailylogin_enabled "${openproject:-0}" && needed+=(make)
  packages=()
  for tool in "${needed[@]}"; do
    command -v "$tool" >/dev/null 2>&1 && continue
    package="$tool"
    [[ "$OSTYPE" == darwin* && "$tool" == python3 ]] && package=python
    packages+=("$package")
  done
  (( ${#packages} )) || return 0
  print -- "dailylogin: installing missing prerequisites: ${packages[*]}"
  if [[ "$OSTYPE" == darwin* ]]; then
    command -v brew >/dev/null 2>&1 || {
      print -u2 -- 'Install Homebrew from https://brew.sh, then rerun dailylogin; it will install the missing packages.'
      return 1
    }
    command brew install "${packages[@]}" || {
      print -u2 -- "Installation failed. Run: brew install ${packages[*]}; then rerun dailylogin."
      return 1
    }
    # Homebrew may have installed a command since zsh last cached executables.
    rehash
  elif command -v apt-get >/dev/null 2>&1; then
    runner=()
    if (( EUID != 0 )); then
      command -v sudo >/dev/null 2>&1 || {
        print -u2 -- "Ask an administrator to run: apt-get update && apt-get install ${packages[*]}; then rerun dailylogin."
        return 1
      }
      runner=(sudo)
      [[ -t 0 ]] || runner+=(-n)
    fi
    "${runner[@]}" apt-get update && "${runner[@]}" apt-get install -y "${packages[@]}" || {
      print -u2 -- "Installation failed. In an interactive terminal run: sudo apt-get update && sudo apt-get install ${packages[*]}; then rerun dailylogin."
      return 1
    }
    rehash
  else
    print -u2 -- "Install ${packages[*]} using your system package manager, then rerun dailylogin."
    return 1
  fi
  for tool in "${needed[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || {
      print -u2 -- "$tool is still unavailable. Check the package installation and PATH, then rerun dailylogin."
      return 1
    }
  done
}

# Capture output before attaching desktop terminals, preserving the caller's cwd.
dailylogin() {
  _dailylogin_dependencies || return $?
  if [[ "${ZSHRC_SETUP_DONE:-0}" == 1 && "${_DAILYLOGIN_REFRESHED:-0}" != 1 ]] && _dailylogin_enabled "$autoupdatezshrc"; then
    _dailylogin_handoff dailylogin "$@"
    return $?
  fi
  local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/42-shell"
  (umask 077; command mkdir -p -- "$log_dir"; command touch -- "$log_dir/dailylogin.log") || return 1
  local log_file="$log_dir/dailylogin.log"
  print -r -- "=== dailylogin $(date) ===" >> "$log_file"
  _dailylogin_impl "$@" > >(command tee -a -- "$log_file") 2>&1
  local result=$?
  local -x DAILY_TMUX_BATCH=1
  _daily_terminal open --cwd "$HOME" dailylogin -- tail -n 1000 -F "$log_file" || return 1
  [[ "${DAILY_TMUX_DEFER_SHOW:-0}" == 1 ]] || _daily_terminal show-all || return 1
  return "$result"
}

_dailylogin_impl() {
  if [[ "${ZSHRC_SETUP_DONE:-0}" != 1 ]]; then
    if [[ -o interactive && -t 0 ]]; then
      setupzshrc || return $?
      print -- 'Setup complete. Run dailylogin again to start your selected tasks.'
      return 0
    fi
    print -u2 -- 'Shell setup required: run setupzshrc in an interactive terminal first.'
    return 1
  fi
  local -i dailylogin_done=0 dailylogin_skipped=0 dailylogin_failed=0
  if ! _dailylogin_enabled "$autoupdatezshrc"; then
    _dailylogin_log SKIP "Pull/update/reload .zshrc (autoupdatezshrc=$autoupdatezshrc)"
    (( dailylogin_skipped += 3 ))
  fi
  # Report the effective settings and dispatch the functions loaded by source.
  _dailylogin_settings
  local -x DAILY_TMUX_BATCH=1
  _dailylogin_tasks "$@"
  _dailylogin_run 'Refresh portable project preference' - refreshproject || true
  _dailylogin_run 'Current Project shell' - _daily_terminal open --cwd "$MAIN_REPO_ROOT/$PROJECTS_ROOT/$current_proj" current-project -- zsh -i || true
  _dailylogin_summary
  (( dailylogin_failed == 0 ))
}

_dailylogin_campus_report() {
  if [[ "$OSTYPE" == darwin* ]]; then
    print -- 'Campus Linux login-hour report skipped on this Mac.'
    return 0
  fi
  "$@"
}

_dailylogin_tasks() {
  # Bootstrap newly added helpers after an older installed updater's first pass.
  if [[ ! -f "$ZSHRC_RUNTIME_ROOT/soft_quit_apps.py" || ! -f "$ZSHRC_RUNTIME_ROOT/lan42_recommend.py" || ! -f "$ZSHRC_RUNTIME_ROOT/mac_mailbox.py" || ! -f "$ZSHRC_RUNTIME_ROOT/login_hours.py" ]]; then
    _dailylogin_run 'Refresh newly added runtime helpers' - synczshrc || return 1
  fi
  _dailylogin_run 'Codex installation/full access/window request' startcodex start_codex || true
  _dailylogin_run "Pull other repositories under $DOCUMENTS_REPOS_ROOT" pullotherrepos syncdocs || true
  if [[ "$OSTYPE" == darwin* ]]; then
    if (( $+functions[schoolimport] )); then
      _dailylogin_run 'Import school chats on this Mac' - schoolimport || true
    fi
  else
    _dailylogin_run 'Import school-chat continuations returned from home' - importhome || true
  fi
  _dailylogin_run 'LAN42 lobby window request' startlan42 start_lan42 || true
  _dailylogin_run 'Mailbox worker check/start' startmailbox start_mailbox || true
  _dailylogin_run 'Stayon (automatic mode)' startstayon stayon start --automatic || true
  _dailylogin_run "Set brightness to $setbrightness%" adjustbrightness adjust_brightness || true
  _dailylogin_run 'Before-noon login report' loginreports loginbefore12 || true
  _dailylogin_run 'Weekly hours report' loginreports hourslogged || true
  _dailylogin_run 'Chrome window request' openchrome _dailylogin_chrome || true
  _dailylogin_run 'Extra login apps (personal opt-in list; setupapps)' - loginapps run || true
  _dailylogin_run 'Main repository Git sync (pull; commit/push if changed)' syncmainrepo syncproj || true
  # Finish in the project even when syncproj changes to the main repository.
  _dailylogin_run "Project $current_proj: change directory, clean, open VS Code" openproject curproj || true
}

# Ensure global full access; leave an already-correct config untouched.
codex_full_access() {
  python3 - "${CODEX_HOME:-$HOME/.codex}/config.toml" <<'PYCODEX'
from pathlib import Path
from datetime import datetime
import re
import shutil
import sys

config = Path(sys.argv[1]).expanduser().resolve()
config.parent.mkdir(parents=True, exist_ok=True)
original = config.read_text() if config.exists() else ""
# Only replace global keys; preserve project and profile sections.
section = re.search(r"(?m)^\s*\[", original)
boundary = section.start() if section else len(original)
header, sections = original[:boundary], original[boundary:]
# Check both TOML quote styles before deciding whether any edit is necessary.
def has_setting(key, value):
    pattern = r"(?m)^[ \t]*" + key + r"[ \t]*=[ \t]*(['\"])" + re.escape(value) + r"\1[ \t]*(?:#.*)?$"
    return re.search(pattern, header)
if has_setting("approval_policy", "never") and has_setting("sandbox_mode", "danger-full-access"):
    print(f"Codex global full access already enabled in {config}")
    sys.exit(0)
header = re.sub(
    r'(?m)^[ \t]*(?:approval_policy|sandbox_mode)[ \t]*=.*(?:\n|$)',
    "", header,
)
updated = ('approval_policy = "never"\n'
           'sandbox_mode = "danger-full-access"\n' + header + sections)
if updated != original:
    if config.exists():
        backup = config.with_name(config.name + ".bak-" + datetime.now().strftime("%Y%m%d-%H%M%S-%f"))
        shutil.copy2(config, backup)
        print(f"Backup: {backup}")
    config.write_text(updated)
    config.chmod(0o600)
print(f"Codex global full access configured in {config}")
print("Restart Codex and start a new session to load the defaults.")
PYCODEX
}

# Install the official standalone CLI only when missing, then open its tmux window.
# Optional local overrides: CODEX_INSTALL_DIR and CODEX_START_DIR.
# Use the general workspace unless the caller explicitly chooses a directory.
codex() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -C|--cd|-C?*|--cd=*) command codex "$@"; return $? ;;
    esac
  done
  command codex --cd "${CODEX_START_DIR:-$MAIN_REPO_ROOT}" "$@"
}

start_codex() {
  _dailylogin_enabled "${startcodex:-0}" || return 0
  local install_dir="${CODEX_INSTALL_DIR:-$HOME/.local/bin}"
  local codex_bin installer
  local start_dir="${CODEX_START_DIR:-$MAIN_REPO_ROOT}"
  [[ -d "$start_dir" ]] || { print -u2 -- "Codex directory missing: $start_dir"; return 1; }
  command -v tmux >/dev/null 2>&1 || { print -u2 -- 'tmux is required for Codex windows.'; return 1; }

  codex_bin=$(whence -p codex)
  if [[ -z "$codex_bin" && -x "$install_dir/codex" ]]; then
    codex_bin="$install_dir/codex"
  fi
  if [[ -z "$codex_bin" ]]; then
    print -- 'Installing Codex with the official standalone installer.'
    installer=$(mktemp "${TMPDIR:-/tmp}/codex-install.XXXXXXXX") || return 1
    if ! command curl -fsSL https://chatgpt.com/codex/install.sh -o "$installer"; then
      command rm -f -- "$installer"
      return 1
    fi
    if ! CODEX_NON_INTERACTIVE=1 CODEX_INSTALL_DIR="$install_dir" command sh "$installer"; then
      command rm -f -- "$installer"
      return 1
    fi
    command rm -f -- "$installer"
    codex_bin="$install_dir/codex"
    [[ -x "$codex_bin" ]] || { print -u2 -- "Installer did not create $codex_bin"; return 1; }
  fi
  codex_full_access || return 1
  # Explicit flags also keep project-level defaults from reducing this launch's access.
  local launch='cd -- "$1" || exit 1
"$2" --ask-for-approval never --sandbox danger-full-access
result=$?
if [ "$result" -ne 0 ]; then
  printf "Codex exited with status %s. Press Enter to close.\n" "$result"
  read -r _
fi'
  _daily_terminal open --cwd "$start_dir" codex -- bash -c "$launch" codex-window "$start_dir" "$codex_bin" || return 1
  print -- 'Codex is in tmux. Use workterm to return; sign in there if prompted.'
}

# Refresh the marked shared block and installed helpers; personal settings stay local.
synczshrc() {
  local repo_root="${ZSHRC_SHARED_ROOT:-${MAIN_REPO_ROOT:-$HOME/Documents/42_Singapore_SUTD}}"
  if [[ ! -f "$repo_root/Useful .zshrc edits (addition)" ]]; then
    print -- 'Update source is unavailable; keeping the installed shell helpers.'
    return 0
  fi
  command python3 "$repo_root/sync_zshrc.py" \
    --source "$repo_root/Useful .zshrc edits (addition)" \
    --runtime "$ZSHRC_RUNTIME_ROOT" \
    --target "${ZDOTDIR:-$HOME}/.zshrc" "$@"
}
if [[ -o interactive && "${ZSHRC_SETUP_DONE:-0}" != 1 ]]; then
  print -- 'First-time 42 shell setup: run setupzshrc to choose your paths and services.'
fi
